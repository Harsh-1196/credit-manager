# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="SHG Credit Manager"

# Database Configuration
# Option 1 (Local dev without Docker):
DATABASE_URL=sqlite+aiosqlite:///shg_dev.db

# Option 2 (Postgres 16 asyncpg with Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shg_credit

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Security
SECRET_KEY=change-this-in-production-must-be-at-least-32-chars-long-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
